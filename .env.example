# HuggingFace token — required to download the Nemotron model on first run
HF_TOKEN=hf_your_token_here

# Transcription backend: nemotron (default) or whisper
STT_BACKEND=nemotron

# Compute device: cuda (default), cpu, or auto
STT_DEVICE=cuda

# Whisper-only: model size (tiny, base, small, medium, large-v3, ...)
WHISPER_MODEL=base

# Whisper-only: BCP-47 language code (en, de, fr, ...) — omit for auto-detect
# WHISPER_LANGUAGE=en
